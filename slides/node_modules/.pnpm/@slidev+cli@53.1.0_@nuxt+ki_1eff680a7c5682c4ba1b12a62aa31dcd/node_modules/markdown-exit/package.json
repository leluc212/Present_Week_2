{
  "name": "markdown-exit",
  "type": "module",
  "version": "2.1.3",
  "description": "A TypeScript rewrite of markdown-it with enhancements",
  "license": "MIT",
  "homepage": "https://github.com/serkodev/markdown-exit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serkodev/markdown-exit.git"
  },
  "bugs": {
    "url": "https://github.com/serkodev/markdown-exit/issues"
  },
  "keywords": [
    "markdown",
    "parser",
    "commonmark",
    "markdown-it",
    "markdown-it-plugin",
    "markdown-exit"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "character-entities": "^2.0.2",
    "linkify-it": "^6.1.0",
    "mdurl": "^2.1.0",
    "punycode.js": "^2.3.1",
    "uc.micro": "^3.0.0"
  },
  "devDependencies": {
    "@markdown-exit/testgen": "2.1.3"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  }
}